{
  "schema": 1,
  "name": "24LC128 16 KiB EEPROM 主机",
  "interface": "i2c",
  "role": "master",
  "protocol": "eeprom",
  "settings": {"address": 80, "capacity": 16384},
  "parameters": [
    {"name": "启动配置", "register": 0, "type": "u32", "endian": "big", "access": "rw"},
    {"name": "页边界数据", "register": 63, "type": "u16", "endian": "big", "access": "rw"},
    {"name": "末地址", "register": 16383, "type": "u8", "access": "rw"}
  ]
}
