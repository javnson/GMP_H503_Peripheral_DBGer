.model div_OSC0_DIV262144_2MHz0 d_fdiv(div_factor=131072 high_cycles=1 i_count=0 rise_delay=1e-12 fall_delay=1e-12)
A_2MHz0_DFF_OSC0_DIV262144 D__2MHz0_OSC0_DIV262144_Q_BAR D__2MHz0_OSC0_DIV262144_MULT2 D_ZERO D_ZERO D__2MHz0_OSC0_DIV262144 D__2MHz0_OSC0_DIV262144_Q_BAR dff_ideal



*// PDLY //*



*// PIN //*

CINA__Input Input_IN_dynamic0 VDD 1.5e-12
CINB__Input Input_IN_dynamic0 GND 1.5e-12
RINA__Input Input_IN_dynamic0 VDD 100000000
RINB__Input Input_IN_dynamic0 GND 100000000
DN__Input GND Input_IN_dynamic0 clamp_diode_1 ; negative clamp
DP__Input Input_IN_dynamic0 VDD clamp_diode_1 ; positive clamp


Enorm__Input A_norm__Input GND VALUE={V(Input_IN_dynamic0,0)/V(VDD,0)}
ABRIDGE-IN__Input [A_norm__Input] [D_norm_del__Input] adc_norm
Xdel__Input D_norm_del__Input D__Input_OUT DELAY_DIST_LUT

* Leakage current at outputs:
R_GreenPOSOUTLEAK Green_OUT_dynamic0 VDD 5e+7
R_GreenNEGOUTLEAK Green_OUT_dynamic0 GND 5e+7
COUTA__Green Green_OUT_dynamic0 VDD 1.5e-12
COUTB__Green Green_OUT_dynamic0 GND 1.5e-12
ROUTA__Green Green_OUT_dynamic0 VDD 100000000
ROUTB__Green Green_OUT_dynamic0 GND 100000000

R_Green_OE A_ONE A__Green_HIZ 1
ABRIDGE-OUT__Green [D__pwm0_OUT0] [A_I__Green] dac_pin_out
EOUT__Green A_OUT_INT__Green GND VALUE = {V(A_I__Green)*V(VDD,GND)}
GOUT__Green Green_OUT_dynamic0 A_OUT_INT__Green VALUE = { V(A_STARTUP)*V(A__Green_HIZ)*(
+ 1*V(A_I__Green)*V(Green_OUT_dynamic0,A_OUT_INT__Green)/V(ROH1X)+
+ 1*(1-V(A_I__Green))*V(Green_OUT_dynamic0,A_OUT_INT__Green)/V(ROL1X)
+ )}

* Leakage current at outputs:
R_RedPOSOUTLEAK Red_OUT_dynamic0 VDD 5e+7
R_RedNEGOUTLEAK Red_OUT_dynamic0 GND 5e+7
COUTA__Red Red_OUT_dynamic0 VDD 1.5e-12
COUTB__Red Red_OUT_dynamic0 GND 1.5e-12
ROUTA__Red Red_OUT_dynamic0 VDD 100000000
ROUTB__Red Red_OUT_dynamic0 GND 100000000

R_Red_OE A_ONE A__Red_HIZ 1
ABRIDGE-OUT__Red [D__pwm1_OUT0] [A_I__Red] dac_pin_out
EOUT__Red A_OUT_INT__Red GND VALUE = {V(A_I__Red)*V(VDD,GND)}
GOUT__Red Red_OUT_dynamic0 A_OUT_INT__Red VALUE = { V(A_STARTUP)*V(A__Red_HIZ)*(
+ 1*V(A_I__Red)*V(Red_OUT_dynamic0,A_OUT_INT__Red)/V(ROH1X)+
+ 1*(1-V(A_I__Red))*V(Red_OUT_dynamic0,A_OUT_INT__Red)/V(ROL1X)
+ )}

* Leakage current at outputs:
R_BluePOSOUTLEAK Blue_OUT_dynamic0 VDD 5e+7
R_BlueNEGOUTLEAK Blue_OUT_dynamic0 GND 5e+7
COUTA__Blue Blue_OUT_dynamic0 VDD 1.5e-12
COUTB__Blue Blue_OUT_dynamic0 GND 1.5e-12
ROUTA__Blue Blue_OUT_dynamic0 VDD 100000000
ROUTB__Blue Blue_OUT_dynamic0 GND 100000000

R_Blue_OE A_ONE A__Blue_HIZ 1
ABRIDGE-OUT__Blue [D__pwm2_OUT0] [A_I__Blue] dac_pin_out
EOUT__Blue A_OUT_INT__Blue GND VALUE = {V(A_I__Blue)*V(VDD,GND)}
GOUT__Blue Blue_OUT_dynamic0 A_OUT_INT__Blue VALUE = { V(A_STARTUP)*V(A__Blue_HIZ)*(
+ 1*V(A_I__Blue)*V(Blue_OUT_dynamic0,A_OUT_INT__Blue)/V(ROH1X)+
+ 1*(1-V(A_I__Blue))*V(Blue_OUT_dynamic0,A_OUT_INT__Blue)/V(ROL1X)
+ )}

* Leakage current at outputs:
R_pin0POSOUTLEAK pin0_OUT_dynamic0 VDD 5e+7
R_pin0NEGOUTLEAK pin0_OUT_dynamic0 GND 5e+7
COUTA__pin0 pin0_OUT_dynamic0 VDD 1.5e-12
COUTB__pin0 pin0_OUT_dynamic0 GND 1.5e-12
ROUTA__pin0 pin0_OUT_dynamic0 VDD 100000000
ROUTB__pin0 pin0_OUT_dynamic0 GND 100000000

R_pin0_OE A_ONE A__pin0_HIZ 1
ABRIDGE-OUT__pin0 [D__Input_OUT] [A_I__pin0] dac_pin_out
EOUT__pin0 A_OUT_INT__pin0 GND VALUE = {V(A_I__pin0)*V(VDD,GND)}
GOUT__pin0 pin0_OUT_dynamic0 A_OUT_INT__pin0 VALUE = { V(A_STARTUP)*V(A__pin0_HIZ)*(
+ 1*V(A_I__pin0)*V(pin0_OUT_dynamic0,A_OUT_INT__pin0)/V(ROH1X)+
+ 1*(1-V(A_I__pin0))*V(pin0_OUT_dynamic0,A_OUT_INT__pin0)/V(ROL1X)
+ )}


*// PIPEDELAY //*



*// POR //*
VSTARTUP A_STARTUP GND PWL(0 0 {1n-1p} 0 1n 1)
ASTARTUP [A_STARTUP] [D_STARTUP] adc_ideal


*// VCC //*
VA_ONE A_ONE GND 1
ABRIDGE_DONE [A_ONE] [D_ONE] adc_ideal
R_VCC0 A__VCC0_OUT VDD 1
ABUF_VCC0 D_ONE D__VCC0_OUT buf_ideal


*// VREF //*


*// WAVE //*


*// Models //*
.model adc_ideal adc_bridge(in_low = 0.5 in_high = 0.5 rise_delay=1e-12 fall_delay=1e-12)
.model dac_ideal dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-12 t_fall=1e-12)
.model dac_pin_out dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-8 t_fall=1e-8)
.model buf_ideal d_buffer(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model and_ideal d_and(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model or_ideal d_or(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model inv_ideal d_inverter(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model buf_del_1ns d_buffer(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model and_del_1ns d_and(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model or_del_1ns d_or(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model inv_del_1ns d_inverter(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model xor_ideal d_xor(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model or2_cnt_rst d_or(rise_delay=1e-9 fall_delay=1e-12 input_load=1e-15)
.model xnor_ideal d_xnor(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model cnt0_rst_dff d_dff(clk_delay=1e-12 set_delay=1e-12 reset_delay=1e-12 ic=0 rise_delay=1e-12 fall_delay=1e-12)
.model state_8cnt d_state(clk_delay=1e-12 reset_delay=1e-12 state_file="C:\ti\interconnectstudio_1.8.0\product\tools\spice64\lib\common\counter_8bit.in" reset_state=0)
.model hyst_pdly hyst(in_low=0.5 in_high=0.5 hyst={0.19153} out_lower_limit=0 out_upper_limit=1 input_domain=0.01 fraction=TRUE)
.model dff_ideal d_dff(clk_delay=1e-12 set_delay=1e-12 reset_delay=1e-12 ic=0 rise_delay=1e-12 fall_delay=1e-12)    
.model adc_norm adc_bridge(in_low = 0.5 in_high = 0.5 rise_delay='1e-9' fall_delay='1e-9')
.model adc_lv_norm adc_bridge(in_low = 0.3 in_high = 0.3 rise_delay='1e-9' fall_delay='1e-9')
.model hyst_norm hyst(in_low=0.5 in_high=0.5 hyst=0.1 out_lower_limit=0 out_upper_limit=1 input_domain=0.01 fraction=TRUE)
.model clamp_diode_1 D (IS=35p RS=64m BV=75 CJO=4p M=0.285 N=1.24)
.ENDS




*// Output and plotting //*


.model dac_ideal dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-12 t_fall=1e-12)
R_U0_context_Input_IN_EXT EXT_ZERO U0_Input 0
R_U0_context_Green_OUT_EXT Green_OUT_EXT_dynamic0 U0_Green 0
R_U0_context_Red_OUT_EXT Red_OUT_EXT_dynamic0 U0_Red 0
R_U0_context_Blue_OUT_EXT Blue_OUT_EXT_dynamic0 U0_Blue 0



.control
save U0_Input U0_Green U0_Red U0_Blue
tran 9.999999999999999e-6 1e-2 0e+0 
* step units: us
* step value: 0.000009999999999999999
plot U0_Input+15 U0_Green+10 U0_Red+5 U0_Blue+0 xlimit 0e+0 1e-2
.endc




*// Sub-circuits required for operation //*
* Nanoseconds - 10 segment distributed delay (up to one full period of delay)
* 7
.SUBCKT DELAY_DIST_LUT IN OUT
.model dist_dly_buff d_buffer(rise_delay = 3.5n fall_delay = 3.5n)
A_out_buff IN OUT dist_dly_buff
.ENDS DELAY_DIST_LUT

.SUBCKT LOGIC_TRI_STATE_OUTPUT IN OUT OEZ VCC VEE
EROH NROH VEE TABLE {V(VCC,VEE)} = 
+ (1.8,61)
+ (3.3,50)
+ (5,37)
EROL NROL VEE TABLE {V(VCC,VEE)} = 
+ (1.8,18)
+ (3.3,14)
+ (5,9) 
EOEZ N2 VEE VALUE = {V(OEZ,VEE)} 
E1 N1 VEE VALUE = {V(VCC,VEE)*V(IN,VEE)*V(N2,VEE)} 
GOUT N1 OUT VALUE = {V(N1,OUT)*V(N2,VEE)*(V(IN,VEE)/V(NROH,VEE) + (1 - V(IN,VEE))/V(NROL,VEE))} 
ROUT OUT VEE 1E8 
.ENDS 

.SUBCKT SUPPLY_CURRENT VCC VEE
+ PARAMS:
+  ICC = 100n
+  VMAX = 5.5
+  VMIN = 1.65
.PARAM RCC = VMAX/ICC
GICC VCC VEE VALUE = {IF(V(VCC,VEE)<VMIN,1,0)*V(VCC,VEE)/RCC}
.ENDS

.end
